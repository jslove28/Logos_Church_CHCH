{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Edit(index.html)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(ls *)",
      "mcp__github__create_or_update_file",
      "mcp__github__get_file_contents"
    ]
  }
}
